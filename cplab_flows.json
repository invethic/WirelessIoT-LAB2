 {
  "id": "cplabw051",
  "type": "ui-template",
  "z": "cplabt003",
  "group": "cplabg018",
  "page": "",
  "ui": "",
  "name": "Messages",
  "order": 1,
  "width": "0",
  "height": "0",
  "head": "",
  "format": "<template>\n  <div class=\"ms\">\n    <label>Destinataire\n      <select v-model=\"target\">\n        <option value=\"all\">Toutes les Tab5</option><option value=\"prod\">Groupe production</option><option value=\"maint\">Groupe maintenance</option>\n        <option v-for=\"d in devs\" :key=\"d\" :value=\"d\">{{ d }}</option>\n      </select></label>\n    <label>Niveau\n      <select v-model=\"level\"><option value=\"info\">Information</option><option value=\"warn\">Attention</option><option value=\"alarm\">Alarme</option></select></label>\n    <label>Duree (s) <input type=\"number\" min=\"3\" max=\"600\" v-model.number=\"duration\" /></label>\n    <textarea v-model=\"text\" rows=\"3\" placeholder=\"Texte affiche sur la Tab5 (sans accents de preference)\"></textarea>\n    <button @click=\"sendMsg\" :disabled=\"!text\">Envoyer le message</button>\n  </div>\n</template>\n<script>\nexport default {\n  data() { return { target: 'all', level: 'info', duration: 15, text: '',\n    devs: ['prod-st1','prod-st2','prod-st3','prod-color','prod-hmi','maint-m1','maint-m2','maint-m3','maint-m4'] } },\n  methods: { sendMsg() {\n    this.send({ topic: 'cmd', payload: { target: this.target, kind: 'msg', text: this.text, level: this.level, duration: this.duration, from: 'Superviseur' } });\n    this.text = '';\n  } }\n}\n</script>\n<style>\n.ms { display: grid; gap: 8px; font-family: Barlow, Roboto, sans-serif; }\n.ms label { display: flex; justify-content: space-between; gap: 8px; align-items: center; }\n.ms select, .ms input, .ms textarea { padding: 4px 6px; border: 1px solid #c4cad0; border-radius: 4px; font: inherit; }\n.ms button { background: #0a8ad0; color: #fff; border: 0; border-radius: 4px; padding: 8px 14px; cursor: pointer; } .ms button:disabled { opacity: .5; }\n</style>",
