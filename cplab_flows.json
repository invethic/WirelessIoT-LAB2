 {
  "id": "cplabf057",
  "type": "function",
  "z": "cplabt004",
  "name": "line simulator",
  "func": "\n// Coherent line simulation: pieces flow st1 -> st4, st3 is the bottleneck\nif (!flow.get('sim')) return null;\nconst S = flow.get('simState') || { c: [0, 0, 0, 0], last: [0, 0, 0, 0], cyc: [0, 0, 0, 0], col: { RED: 0, GREEN: 0, BLUE: 0, BLACK: 0, UNKNOWN: 0 }, m: ['RUN', 'RUN', 'RUN', 'RUN'], mt: [0, 0, 0, 0], tick: 0 };\nconst now = Date.now(), wipMax = 3, out = [];\nconst p = [0.30, 0.35, 0.22, 0.45];           // chance per second to finish a piece\nconst names = ['Magasin', 'Presse', 'Controle', 'Controle couleur'];\nS.tick++;\nfor (let i = 3; i >= 0; i--) {\n  const upstreamOk = i === 0 ? (S.c[0] - S.c[1] <= wipMax) : (S.c[i - 1] > S.c[i]);\n  if (S.m[i] === 'RUN' && upstreamOk && Math.random() < p[i]) {\n    if (S.last[i]) S.cyc[i] = now - S.last[i];\n    S.last[i] = now; S.c[i]++;\n    if (i === 3) {\n      const r = Math.random(); const col = r < .27 ? 'RED' : r < .52 ? 'GREEN' : r < .77 ? 'BLUE' : r < .98 ? 'BLACK' : 'UNKNOWN';\n      S.col[col]++; out.push({ topic: 'cplab/prod/color/last', payload: { color: col, sim: true } });\n    }\n  }\n}\nfor (let i = 0; i < 4; i++) {\n  const wip = i < 3 ? S.c[i] - S.c[i + 1] : -1;\n  const kanban = i === 3 ? 'GREEN' : wip > wipMax ? 'RED' : wip === wipMax ? 'AMBER' : 'GREEN';\n  out.push({ topic: `cplab/prod/st${i + 1}/count`, retain: true, payload: { st: i + 1, id: 'st' + (i + 1), name: names[i], count: S.c[i],\n    cycle_ms: S.cyc[i], cadence: S.cyc[i] ? Math.round(600000 / S.cyc[i]) / 10 : 0, takt_s: 20, wip_out: wip, wip_max: wipMax, kanban,\n    state: now - S.last[i] < 15000 ? 'RUN' : 'WAIT', sim: true } });\n}\nout.push({ topic: 'cplab/prod/color/count', retain: true, payload: Object.assign({ total: S.c[3] }, S.col) });\n// maintenance: random breakdowns (~1 every 4 min per machine), repaired after 20-60 s\nfor (let i = 0; i < 4; i++) {\n  if (S.m[i] === 'RUN' && Math.random() < 1 / 240) { S.m[i] = 'ABNORMAL'; S.mt[i] = now + 20000 + Math.random() * 40000; }\n  else if (S.m[i] === 'ABNORMAL' && now > S.mt[i]) { S.m[i] = 'RUN'; }\n  if (S.tick % 5 === 0 || S.m[i] !== (S.prevM || [])[i])\n    out.push({ topic: `cplab/maint/m${i + 1}/state`, retain: true, payload: { m: i + 1, id: 'm' + (i + 1), name: 'Machine ' + (i + 1),\n      state: S.m[i], reason: S.m[i] === 'ABNORMAL' ? 'Vibrations excessives' : '', activity: S.m[i] === 'ABNORMAL' ? 95 : 25 + Math.random() * 8, sim: true } });\n}\nS.prevM = S.m.slice();\nflow.set('simState', S);\nnode.status({ fill: 'green', shape: 'ring', text: 'out: ' + S.c[3] });\nreturn [out];\n",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
