  "head": "",
  "format": "<template>\n  <div class=\"mm\" v-if=\"msg && msg.payload\">\n    <div v-for=\"m in msg.payload.machines\" :key=\"m.id\" class=\"card\" :class=\"'s-' + (m.state || 'NONE')\">\n      <div class=\"hd\"><b>{{ m.id.toUpperCase() }}</b> {{ m.name || '' }}</div>\n      <div class=\"st\">{{ ({RUN:'En marche', OFF:'Arret', ABNORMAL:'Anomalie'})[m.state] || 'Pas de donnees' }}</div>\n      <div class=\"rs\">{{ m.reason }} <span v-if=\"m.sim\">(simulation)</span></div>\n      <div class=\"nums\">\n        <div><b>{{ m.stats.day }}</b><small>pannes 24 h</small></div>\n        <div><b>{{ m.stats.week }}</b><small>pannes 7 j</small></div>\n        <div><b>{{ m.stats.mttr_min ?? '--' }}</b><small>MTTR min</small></div>\n      </div>\n      <div class=\"pl\"><small>Preventive</small> {{ m.stats.next_prev ? m.stats.next_prev.date + ' - ' + m.stats.next_prev.task : 'non planifiee' }}</div>\n      <div class=\"pl\"><small>Curative</small> {{ m.stats.next_cur ? m.stats.next_cur.date + ' - ' + m.stats.next_cur.task : 'aucune' }}</div>\n      <div class=\"act\">\n        <button @click=\"act(m.id,'ack')\">Acquitter</button>\n        <button class=\"sec\" @click=\"cmd(m.id,'sim_fault')\">Simuler panne</button>\n        <button class=\"sec\" @click=\"cmd(m.id,'learn')\">Apprendre</button>\n      </div>\n    </div>\n  </div>\n  <div v-else class=\"empty\">En attente des donnees MQTT (topics cplab/maint/#)...</div>\n</template>\n<script>\nexport default {\n  methods: {\n    act(id, kind) { this.send({ topic: 'ack', payload: { id } }) },\n    cmd(id, c) { this.send({ topic: 'cmd', payload: { target: 'maint-' + id, kind: 'action', cmd: c } }) }\n  }\n}\n</script>\n<style>\n.mm { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; font-family: Barlow, Roboto, sans-serif; }\n.mm .card { border: 1px solid #c4cad0; border-top: 10px solid #8c969f; border-radius: 6px; padding: 10px; background: #fff; }\n.mm .s-RUN { border-top-color: #1f9d55; } .mm .s-ABNORMAL { border-top-color: #cf3b3b; background: #fdf3f3; }\n.mm .st { font-size: 24px; font-weight: 700; } .mm .rs { color: #cf3b3b; min-height: 18px; font-size: 13px; }\n.mm .nums { display: flex; justify-content: space-between; margin: 8px 0; text-align: center; }\n.mm .nums b { display: block; font-size: 26px; } .mm .nums small, .mm .pl small { color: #606c76; }\n.mm .pl { font-size: 13px; margin: 2px 0; } .mm .act { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }\n.mm button { background: #0a8ad0; color: #fff; border: 0; border-radius: 4px; padding: 6px 10px; cursor: pointer; } .mm button.sec { background: #606c76; }\n.empty { color: #606c76; padding: 20px; }\n</style>",
