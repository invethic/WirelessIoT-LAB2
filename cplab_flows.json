 {
  "id": "cplabf020",
  "type": "function",
  "z": "cplabt001",
  "name": "Dashboard -> MQTT",
  "func": "\n// Converts dashboard requests into MQTT messages (same protocol as the web site)\nconst p = msg.payload || {};\nconst out = { qos: 1 };\nswitch (msg.topic) {\n  case 'cmd':      // {target, kind:'msg'|'action', ...}\n    out.topic = `cplab/cmd/${p.target || 'all'}/${p.kind === 'action' ? 'action' : 'msg'}`;\n    out.payload = p.kind === 'action'\n      ? Object.assign({}, p.data || {}, { cmd: p.cmd })\n      : { text: p.text || '', from: p.from || 'Node-RED', level: p.level || 'info', duration: Number(p.duration) || 15 };\n    out.retain = false; break;\n  case 'order':    // OF -> retained so every Tab5 gets it at (re)connection\n    out.topic = 'cplab/prod/order'; out.payload = p; out.retain = true; break;\n  case 'plan':     // {id:'m1', plan:{prev:{date,task}, cur:{date,task}}}\n    out.topic = `cplab/maint/${p.id}/plan/set`; out.payload = p.plan; out.retain = false; break;\n  case 'ack':\n    out.topic = `cplab/maint/${p.id}/ack`; out.payload = { id: p.id, by: 'superviseur' }; out.retain = false; break;\n  default: return null;\n}\nnode.status({ fill: 'blue', shape: 'dot', text: out.topic });\nreturn out;\n",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 690,
  "y": 220,
  "wires": [
   [
    "cplabo021"
   ]
  ]
 },
 {
  "id": "cplabw029",
  "type": "ui-template",
  "z": "cplabt001",
  "group": "cplabg012",
  "page": "",
  "ui": "",
  "name": "Formulaire OF",
  "order": 1,
  "width": "0",
  "height": "0",
  "head": "",
  "format": "<template>\n  <div class=\"of\">\n    <label>Numero OF <input v-model=\"of\" /></label>\n    <div class=\"q\">\n      <label v-for=\"c in cols\" :key=\"c\">{{ c }} <input type=\"number\" min=\"0\" v-model.number=\"qty[c]\" /></label>\n    </div>\n    <label>Takt (s) <input type=\"number\" min=\"1\" v-model.number=\"takt\" /></label>\n    <label>WIP max par buffer <input type=\"number\" min=\"1\" max=\"8\" v-model.number=\"wip\" /></label>\n    <div class=\"btns\">\n      <button @click=\"sendOrder\">Lancer l'OF</button>\n      <button class=\"sec\" @click=\"resetLine\">Remettre les compteurs a zero</button>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data() { return { of: 'OF-001', cols: ['RED', 'GREEN', 'BLUE', 'BLACK'], qty: { RED: 5, GREEN: 5, BLUE: 5, BLACK: 5 }, takt: 20, wip: 3 } },\n  methods: {\n    sendOrder() { this.send({ topic: 'order', payload: { of: this.of, qty: { ...this.qty }, takt_s: this.takt, wip_max: this.wip, ts: Date.now() } }) },\n    resetLine() { if (confirm('Remettre a zero tous les compteurs de production ?')) this.send({ topic: 'cmd', payload: { target: 'prod', kind: 'action', cmd: 'reset' } }) }\n  }\n}\n</script>\n<style>\n.of { display: grid; gap: 8px; font-family: Barlow, Roboto, sans-serif; }\n.of label { display: flex; justify-content: space-between; align-items: center; gap: 8px; }\n.of input { width: 110px; padding: 4px 6px; border: 1px solid #c4cad0; border-radius: 4px; }\n.of .q { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; }\n.of .btns { display: flex; gap: 8px; flex-wrap: wrap; }\n.of button { background: #0a8ad0; color: #fff; border: 0; border-radius: 4px; padding: 8px 14px; cursor: pointer; }\n.of button.sec { background: #606c76; }\n</style>",
  "storeOutMessages": true,
