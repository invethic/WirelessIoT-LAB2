 {
  "id": "cplabw022",
  "type": "ui-template",
  "z": "cplabt001",
  "group": "cplabg011",
  "page": "",
  "ui": "",
  "name": "Synoptique ligne",
  "order": 1,
  "width": "0",
  "height": "0",
  "head": "",
  "format": "<template>\n  <div class=\"cp\" v-if=\"msg && msg.payload\">\n    <div class=\"line\">\n      <template v-for=\"(s, i) in msg.payload.stations\" :key=\"s.id\">\n        <div class=\"st\" :class=\"['k-' + (s.kanban || 'UNKNOWN'), s.state === 'RUN' ? 'run' : 'wait']\">\n          <div class=\"nm\">Poste {{ i + 1 }} <span>{{ s.name || '' }}</span></div>\n          <div class=\"ct\">{{ s.count ?? '--' }}</div>\n          <div class=\"sm\">{{ s.cadence ?? 0 }} pcs/min &nbsp; cycle {{ s.cycle_ms ? (s.cycle_ms / 1000).toFixed(1) + ' s' : '--' }}</div>\n        </div>\n        <div v-if=\"i < 3\" class=\"buf\" :class=\"'b-' + msg.payload.buffers[i].level\">\n          <b>{{ msg.payload.buffers[i].wip ?? '?' }}</b><small>WIP / {{ msg.payload.wipMax }}</small>\n        </div>\n      </template>\n    </div>\n    <div class=\"row\">\n      <div class=\"col\">\n        <h4>Avancement OF {{ msg.payload.order.of || '' }}</h4>\n        <div v-for=\"c in msg.payload.colors\" :key=\"c.c\" class=\"bar\">\n          <span class=\"sw\" :class=\"'c-' + c.c\"></span><span class=\"lb\">{{ c.c }}</span>\n          <div class=\"trk\"><div class=\"fill\" :class=\"'c-' + c.c\" :style=\"{ width: (c.target ? Math.min(100, 100 * c.n / c.target) : 0) + '%' }\"></div></div>\n          <span class=\"vl\">{{ c.n }}<template v-if=\"c.target\"> / {{ c.target }}</template></span>\n        </div>\n        <div v-if=\"msg.payload.unknown\" class=\"unk\">Couleur inconnue: {{ msg.payload.unknown }}</div>\n      </div>\n      <div class=\"col kpi\">\n        <h4>Indicateurs</h4>\n        <p>Takt: <b>{{ msg.payload.order.takt_s ?? '--' }} s</b></p>\n        <p v-if=\"msg.payload.bottleneck\">Goulot: <b>{{ msg.payload.bottleneck.id }}</b> ({{ (msg.payload.bottleneck.cycle_ms / 1000).toFixed(1) }} s)</p>\n        <p v-if=\"msg.payload.lastColor\">Derniere piece: <b>{{ msg.payload.lastColor.color }}</b></p>\n      </div>\n    </div>\n  </div>\n  <div v-else class=\"cp empty\">En attente des donnees MQTT (topics cplab/prod/#)...</div>\n</template>\n<style>\n.cp { font-family: Barlow, Roboto, sans-serif; color: #16212b; }\n.cp .line { display: flex; align-items: center; gap: 0; background: linear-gradient(#e6e9ec, #e6e9ec) center/100% 10px no-repeat; }\n.cp .st { flex: 1; background: #fff; border: 1px solid #c4cad0; border-top: 8px solid #8c969f; border-radius: 6px; padding: 10px 12px; min-width: 0; }\n.cp .st.run { border-top-color: #1f9d55; } .cp .st.wait { border-top-color: #e8a317; }\n.cp .nm { font-weight: 700; } .cp .nm span { font-weight: 400; color: #606c76; }\n.cp .ct { font-size: 44px; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }\n.cp .sm { font-size: 13px; color: #606c76; }\n.cp .buf { width: 74px; height: 74px; margin: 0 10px; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; background: #8c969f; flex: none; }\n.cp .buf b { font-size: 24px; line-height: 1; } .cp .buf small { font-size: 10px; }\n.cp .b-ok { background: #1f9d55; } .cp .b-limit, .cp .b-error { background: #e8a317; } .cp .b-over { background: #cf3b3b; }\n.cp .row { display: flex; gap: 16px; margin-top: 16px; flex-wrap: wrap; } .cp .col { flex: 1; min-width: 260px; }\n.cp h4 { margin: 0 0 8px; font-size: 15px; color: #606c76; font-weight: 600; }\n.cp .bar { display: flex; align-items: center; gap: 8px; margin: 6px 0; }\n.cp .sw { width: 16px; height: 16px; border-radius: 3px; } .cp .lb { width: 60px; font-size: 13px; }\n.cp .trk { flex: 1; height: 12px; background: #e6e9ec; border-radius: 3px; overflow: hidden; } .cp .fill { height: 100%; }\n.cp .vl { width: 70px; text-align: right; font-variant-numeric: tabular-nums; }\n.cp .c-RED { background: #cf3b3b; } .cp .c-GREEN { background: #1f9d55; } .cp .c-BLUE { background: #0a8ad0; } .cp .c-BLACK { background: #16212b; }\n.cp .unk { color: #cf3b3b; font-size: 13px; } .cp .kpi p { margin: 4px 0; }\n.cp.empty { color: #606c76; padding: 20px; }\n</style>",
  "storeOutMessages": true,
  "passthru": false,
  "resendOnRefresh": true,
  "templateScope": "local",
  "className": "",
  "x": 690,
  "y": 100,
  "wires": [
   []
  ]
 },
 {
  "id": "cplabw023",
  "type": "ui-template",
  "z": "cplabt001",
  "group": "cplabg013",
  "page": "",
  "ui": "",
  "name": "Andon",
  "order": 1,
  "width": "0",
  "height": "0",
  "head": "",
  "format": "<template>\n  <div class=\"an\">\n    <div v-if=\"!msg || !msg.payload || !msg.payload.andon.length\" class=\"none\">Aucun appel Andon.</div>\n    <div v-else v-for=\"a in msg.payload.andon\" :key=\"a.ts\" class=\"it\" :class=\"a.type\">\n      <b>{{ a.type === 'quality' ? 'Alerte qualite' : 'Appel superviseur' }}</b>\n      <span>{{ a.from }} - {{ new Date(a.ts).toLocaleTimeString() }}</span>\n    </div>\n  </div>\n</template>\n<style>\n.an .it { padding: 6px 10px; margin-bottom: 6px; border-left: 6px solid #e8a317; background: #fdf6e6; display: flex; justify-content: space-between; }\n.an .it.quality { border-left-color: #cf3b3b; background: #fbeaea; } .an .none { color: #606c76; }\n</style>",
  "storeOutMessages": true,
  "passthru": false,
  "resendOnRefresh": true,
