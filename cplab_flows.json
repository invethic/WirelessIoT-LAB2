 {
  "id": "cplabf035",
  "type": "function",
  "z": "cplabt002",
  "name": "Maintenance model",
  "func": "\n// Maintenance model: machine states, breakdown history, plans -> stats\nconst M = global.get('maint') || { machines: {}, history: {}, plans: {}, events: [] };\nconst now = Date.now(), DAY = 864e5;\nconst IDS = ['m1', 'm2', 'm3', 'm4'];\nconst changed = new Set();\nconst t = (msg.topic || '').split('/');                  // cplab/maint/m1/state\n\nfunction stats(id) {\n  const h = (M.history[id] || []);\n  const day = h.filter(e => now - e.start < DAY).length;\n  const week = h.filter(e => now - e.start < 7 * DAY).length;\n  const closed = h.filter(e => e.end && now - e.start < 7 * DAY);\n  const mttr = closed.length ? closed.reduce((s, e) => s + (e.end - e.start), 0) / closed.length / 60000 : null;\n  const p = M.plans[id] || {};\n  return { id, day, week,\n    mttr_min: mttr === null ? null : Math.round(mttr * 10) / 10,\n    mtbf_h: week ? Math.round(168 / week * 10) / 10 : null,\n    next_prev: p.prev || null, next_cur: p.cur || null, ts: now };\n}\n\nif (msg.topic === 'tick') IDS.forEach(id => changed.add(id));\nelse if (t[3] === 'state') {\n  const id = t[2], st = msg.payload.state, prev = M.machines[id];\n  if (!prev || prev.state !== st) {\n    M.events.unshift({ ts: now, id, from: prev ? prev.state : null, to: st, reason: msg.payload.reason || '', sim: !!msg.payload.sim });\n    M.events = M.events.slice(0, 100);\n    M.history[id] = M.history[id] || [];\n    if (prev && prev.state === 'ABNORMAL') { const last = M.history[id][M.history[id].length - 1]; if (last && !last.end) last.end = now; }\n    if (st === 'ABNORMAL') M.history[id].push({ start: now, reason: msg.payload.reason || '', sim: !!msg.payload.sim });\n    M.history[id] = M.history[id].filter(e => now - e.start < 30 * DAY);\n    changed.add(id);\n  }\n  M.machines[id] = Object.assign({}, msg.payload, { seen: now });\n}\nelse if (t[3] === 'plan') { M.plans[t[2]] = Object.assign(M.plans[t[2]] || {}, msg.payload); changed.add(t[2]); }\nelse if (t[3] === 'ack') { M.events.unshift({ ts: now, id: t[2], to: 'ACK', reason: (msg.payload && msg.payload.by) || '' }); }\nglobal.set('maint', M);\n\nconst statMsgs = [...changed].map(id => ({ topic: `cplab/maint/${id}/stats`, payload: stats(id), retain: true, qos: 1 }));\nconst dash = { payload: {\n  machines: IDS.map(id => Object.assign({ id }, M.machines[id] || {}, { stats: stats(id), plan: M.plans[id] || {} })),\n  events: M.events.slice(0, 30) } };\nreturn [statMsgs, dash];\n",
  "outputs": 2,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
