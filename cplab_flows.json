   []
  ]
 },
 {
  "id": "cplabf024",
  "type": "function",
  "z": "cplabt001",
  "name": "Production model",
  "func": "\n// Production model: stations st1..st4, colour counts, OF, andon\nconst prod = global.get('prod') || { stations: {}, color: {}, order: {}, andon: [] };\nconst t = msg.topic.split('/');            // cplab/prod/<x>/<y>\nconst now = Date.now();\nif (t[2] === 'color' && t[3] === 'count') prod.color = msg.payload;\nelse if (t[2] === 'color' && t[3] === 'last') prod.lastColor = Object.assign({ ts: now }, msg.payload);\nelse if (t[2] === 'order') prod.order = msg.payload || {};\nelse if (t[2] === 'andon') {\n  prod.andon.unshift(Object.assign({ ts: now }, msg.payload));\n  prod.andon = prod.andon.slice(0, 20);\n  node.warn(`ANDON ${msg.payload.type} from ${msg.payload.from}`);\n}\nelse if (/^st[1-4]$/.test(t[2]) && t[3] === 'count') prod.stations[t[2]] = Object.assign({}, msg.payload, { seen: now });\nglobal.set('prod', prod);\n\nconst keys = ['st1', 'st2', 'st3', 'st4'];\nconst wipMax = (prod.order && prod.order.wip_max) || 3;\nconst buffers = [];\nfor (let i = 0; i < 3; i++) {\n  const a = prod.stations[keys[i]], b = prod.stations[keys[i + 1]];\n  const wip = (a && b) ? a.count - b.count : null;\n  const level = wip === null ? 'unknown' : wip < 0 ? 'error' : wip > wipMax ? 'over' : wip === wipMax ? 'limit' : 'ok';\n  buffers.push({ from: keys[i], to: keys[i + 1], wip, level });\n}\nconst colors = ['RED', 'GREEN', 'BLUE', 'BLACK'].map(c => ({\n  c, n: (prod.color && prod.color[c]) || 0, target: (prod.order && prod.order.qty && prod.order.qty[c]) || 0\n}));\nlet bottleneck = null;\nkeys.forEach(k => { const s = prod.stations[k]; if (s && s.cycle_ms && (!bottleneck || s.cycle_ms > bottleneck.cycle_ms)) bottleneck = { id: k, cycle_ms: s.cycle_ms }; });\nreturn { payload: {\n  stations: keys.map(k => prod.stations[k] || { id: k }),\n  buffers, colors, unknown: (prod.color && prod.color.UNKNOWN) || 0,\n  order: prod.order, wipMax, bottleneck, andon: prod.andon.slice(0, 8), lastColor: prod.lastColor || null\n}};\n",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 440,
  "y": 120,
  "wires": [
   [
    "cplabw022",
    "cplabw023"
   ]
  ]
 },
