 {
  "id": "cplabf040",
  "type": "function",
  "z": "cplabt002",
  "name": "Dashboard -> MQTT",
  "func": "\n// Converts dashboard requests into MQTT messages (same protocol as the web site)\nconst p = msg.payload || {};\nconst out = { qos: 1 };\nswitch (msg.topic) {\n  case 'cmd':      // {target, kind:'msg'|'action', ...}\n    out.topic = `cplab/cmd/${p.target || 'all'}/${p.kind === 'action' ? 'action' : 'msg'}`;\n    out.payload = p.kind === 'action'\n      ? Object.assign({}, p.data || {}, { cmd: p.cmd })\n      : { text: p.text || '', from: p.from || 'Node-RED', level: p.level || 'info', duration: Number(p.duration) || 15 };\n    out.retain = false; break;\n  case 'order':    // OF -> retained so every Tab5 gets it at (re)connection\n    out.topic = 'cplab/prod/order'; out.payload = p; out.retain = true; break;\n  case 'plan':     // {id:'m1', plan:{prev:{date,task}, cur:{date,task}}}\n    out.topic = `cplab/maint/${p.id}/plan/set`; out.payload = p.plan; out.retain = false; break;\n  case 'ack':\n    out.topic = `cplab/maint/${p.id}/ack`; out.payload = { id: p.id, by: 'superviseur' }; out.retain = false; break;\n  default: return null;\n}\nnode.status({ fill: 'blue', shape: 'dot', text: out.topic });\nreturn out;\n",
