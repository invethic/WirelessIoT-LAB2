  "format": "<template>\n  <div class=\"pf\">\n    <label>Machine <select v-model=\"id\"><option v-for=\"m in ['m1','m2','m3','m4']\" :key=\"m\" :value=\"m\">{{ m.toUpperCase() }}</option></select></label>\n    <fieldset><legend>Prochaine action preventive</legend>\n      <input type=\"date\" v-model=\"pd\" /> <input v-model=\"pt\" placeholder=\"Tache (ex: graissage convoyeur)\" /></fieldset>\n    <fieldset><legend>Prochaine action curative</legend>\n      <input type=\"date\" v-model=\"cd\" /> <input v-model=\"ct\" placeholder=\"Tache (ex: changer courroie)\" /></fieldset>\n    <button @click=\"save\">Enregistrer le plan</button>\n  </div>\n</template>\n<script>\nexport default {\n  data() { return { id: 'm1', pd: '', pt: '', cd: '', ct: '' } },\n  methods: { save() {\n    const plan = {};\n    plan.prev = this.pd || this.pt ? { date: this.pd, task: this.pt } : null;\n    plan.cur = this.cd || this.ct ? { date: this.cd, task: this.ct } : null;\n    this.send({ topic: 'plan', payload: { id: this.id, plan } });\n  } }\n}\n</script>\n<style>\n.pf { display: grid; gap: 8px; font-family: Barlow, Roboto, sans-serif; }\n.pf fieldset { border: 1px solid #c4cad0; border-radius: 4px; display: flex; gap: 6px; flex-wrap: wrap; }\n.pf input, .pf select { padding: 4px 6px; border: 1px solid #c4cad0; border-radius: 4px; }\n.pf button { background: #0a8ad0; color: #fff; border: 0; border-radius: 4px; padding: 8px 14px; cursor: pointer; justify-self: start; }\n</style>",
