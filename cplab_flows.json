  "z": "cplabt003",
  "name": "Device registry",
  "func": "\n// Device registry from LWT + heartbeat\nconst D = global.get('devices') || {};\nconst t = msg.topic.split('/');               // cplab/status/<id> | cplab/hb/<id> | cplab/ack/<id>\nconst id = t[2], now = Date.now();\nD[id] = D[id] || { id };\nif (t[1] === 'status') D[id].online = String(msg.payload) === 'online';\nelse if (t[1] === 'hb') { Object.assign(D[id], msg.payload); D[id].online = true; D[id].seen = now; }\nelse if (t[1] === 'ack') { D[id].lastAck = { ts: now, text: msg.payload && msg.payload.text }; }\nglobal.set('devices', D);\nconst list = Object.values(D).sort((a, b) => a.id.localeCompare(b.id))\n  .map(d => Object.assign({}, d, { stale: d.seen ? (now - d.seen > 30000) : true }));\nreturn { payload: list };\n",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 440,
  "y": 100,
